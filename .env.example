# Anthropic API key for the Claude Agent SDK (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Model for the tutor agent (chat). Aliases like opus / sonnet work.
TUTOR_MODEL=opus

# Model for utility work (lesson rewrites, summaries)
UTIL_MODEL=sonnet

# Fastify port
PORT=3111

# Bind address. Keep 127.0.0.1 locally; Docker sets 0.0.0.0
HOST=127.0.0.1
