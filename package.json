{
  "name": "body-double",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": "github:kurkul608/body-double",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
